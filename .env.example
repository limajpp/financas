# Copie para .env e preencha. Nunca commite o .env.
# As variáveis entram conforme as tasks forem chegando:
#   task 2  → DATABASE_URL, TEST_DATABASE_URL
#   task 3  → BETTER_AUTH_SECRET, BETTER_AUTH_URL
#   task 17 → VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, CRON_SECRET

# Postgres do docker-compose.yml (porta 5433 no host; troque com POSTGRES_PORT).
DATABASE_URL="postgresql://financas@localhost:5433/financas"
# Banco dos testes de integração. O nome precisa terminar em _test: o setup apaga tudo nele.
TEST_DATABASE_URL="postgresql://financas@localhost:5433/financas_test"

# Better Auth. Gere o segredo com `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Rate limit do login/cadastro: liga sozinho em produção. "off" desliga (e2e), "on" força em dev.
# AUTH_RATE_LIMIT="on"
