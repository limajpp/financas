generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Fields match Better Auth's core user model, so task 3 only adds the session tables.
model User {
  id            String        @id @default(uuid(7))
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  memberships   SpaceMember[]
  personalSpace Space?        @relation("PersonalSpace")
  sessions      Session[]
  authAccounts  AuthAccount[]
}

// Better Auth tables. Field names follow its core schema.
model Session {
  id        String   @id @default(uuid(7))
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Better Auth's "account" (login credentials). Renamed: Account is the bank account (task 6).
model AuthAccount {
  id                    String    @id @default(uuid(7))
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

// Better Auth rate limit counters. In the database because Vercel instances don't share memory.
model RateLimit {
  id          String @id @default(uuid(7))
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum SpaceType {
  PERSONAL
  SHARED
}

// Every piece of data belongs to a space. v1 only has the personal one.
// personalOwnerId is set only on PERSONAL spaces (CHECK in the migration): one per user.
model Space {
  id                 String        @id @default(uuid(7))
  type               SpaceType
  name               String
  personalOwnerId    String?       @unique
  personalOwner      User?         @relation("PersonalSpace", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  // Set once the default category list was created, so archived defaults never come back.
  categoriesSeededAt DateTime?
  members            SpaceMember[]
  categories         Category[]
  accounts           Account[]
}

enum SpaceRole {
  OWNER
  MEMBER
}

model SpaceMember {
  id        String    @id @default(uuid(7))
  spaceId   String
  userId    String
  role      SpaceRole
  createdAt DateTime  @default(now())
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([userId])
}

enum CategoryType {
  EXPENSE
  INCOME
}

/// Two-level tree (parent → children). Depth, sibling-name uniqueness and type inheritance are
/// enforced by src/domain/categories.ts, not by the database.
model Category {
  id         String       @id @default(uuid(7))
  spaceId    String
  space      Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Category?    @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: NoAction)
  children   Category[]   @relation("CategoryChildren")
  name       String
  type       CategoryType
  icon       String
  color      String
  isFixed    Boolean      @default(false)
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([spaceId, type])
  @@index([parentId])
}

/// A bank account. Its balance is the initial balance on a calendar day plus the transactions
/// after it (task 8).
model Account {
  id                  String    @id @default(uuid(7))
  spaceId             String
  space               Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name                String
  color               String
  /// May be negative (overdraft).
  initialBalanceCents Int
  /// A calendar day, not an instant.
  initialBalanceDate  DateTime  @db.Date
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([spaceId])
}
