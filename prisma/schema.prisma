generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Fields match Better Auth's core user model, so task 3 only adds the session tables.
model User {
  id             String          @id @default(uuid(7))
  name           String
  email          String          @unique
  emailVerified  Boolean         @default(false)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  memberships    SpaceMember[]
  personalSpace  Space?          @relation("PersonalSpace")
  sessions       Session[]
  authAccounts   AuthAccount[]
  transactions   Transaction[]
  recurringRules RecurringRule[]
}

// Better Auth tables. Field names follow its core schema.
model Session {
  id        String   @id @default(uuid(7))
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Better Auth's "account" (login credentials). Renamed: Account is the bank account (task 6).
model AuthAccount {
  id                    String    @id @default(uuid(7))
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

// Better Auth rate limit counters. In the database because Vercel instances don't share memory.
model RateLimit {
  id          String @id @default(uuid(7))
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum SpaceType {
  PERSONAL
  SHARED
}

// Every piece of data belongs to a space. v1 only has the personal one.
// personalOwnerId is set only on PERSONAL spaces (CHECK in the migration): one per user.
model Space {
  id                 String          @id @default(uuid(7))
  type               SpaceType
  name               String
  personalOwnerId    String?         @unique
  personalOwner      User?           @relation("PersonalSpace", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  // Set once the default category list was created, so archived defaults never come back.
  categoriesSeededAt DateTime?
  members            SpaceMember[]
  categories         Category[]
  accounts           Account[]
  cards              Card[]
  counterparties     Counterparty[]
  transactions       Transaction[]
  recurringRules     RecurringRule[]
}

enum SpaceRole {
  OWNER
  MEMBER
}

model SpaceMember {
  id        String    @id @default(uuid(7))
  spaceId   String
  userId    String
  role      SpaceRole
  createdAt DateTime  @default(now())
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([userId])
}

enum CategoryType {
  EXPENSE
  INCOME
}

/// Two-level tree (parent → children). Depth, sibling-name uniqueness and type inheritance are
/// enforced by src/domain/categories.ts, not by the database.
model Category {
  id                     String          @id @default(uuid(7))
  spaceId                String
  space                  Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parentId               String?
  parent                 Category?       @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: NoAction)
  children               Category[]      @relation("CategoryChildren")
  transactions           Transaction[]
  defaultForCounterparty Counterparty[]
  name                   String
  type                   CategoryType
  icon                   String
  color                  String
  isFixed                Boolean         @default(false)
  archivedAt             DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  recurringRules         RecurringRule[]

  @@index([spaceId, type])
  @@index([parentId])
}

/// A bank account. Its balance is the initial balance on a calendar day plus the transactions
/// after it (task 8).
model Account {
  id                  String    @id @default(uuid(7))
  spaceId             String
  space               Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name                String
  color               String
  /// May be negative (overdraft).
  initialBalanceCents Int
  /// A calendar day, not an instant.
  initialBalanceDate  DateTime  @db.Date
  /// When the initial balance (amount or day) was last informed: entries of that same day
  /// registered after it count in the balance (src/domain/balance.ts).
  initialBalanceSetAt DateTime  @default(now())
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  cards          Card[]
  transactions   Transaction[]   @relation("AccountTransactions")
  transfersIn    Transaction[]   @relation("AccountTransfersIn")
  recurringRules RecurringRule[]

  @@index([spaceId])
}

/// A credit card. The invoice a purchase falls on comes from the cycle valid on the purchase date
/// (src/domain/invoice-cycle.ts).
model Card {
  id             String          @id @default(uuid(7))
  spaceId        String
  space          Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// The account that pays the invoice.
  accountId      String
  account        Account         @relation(fields: [accountId], references: [id], onDelete: NoAction)
  name           String
  limitCents     Int?
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  cycles         CardCycle[]
  transactions   Transaction[]
  recurringRules RecurringRule[]

  @@index([spaceId])
  @@index([accountId])
}

/// A version of a card's closing/due days, valid for purchases from `validFrom` on.
/// Days are 1–31 (CHECK in the migration); a day the month lacks means its last day.
model CardCycle {
  id         String   @id @default(uuid(7))
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  closingDay Int
  dueDay     Int
  validFrom  DateTime @db.Date
  createdAt  DateTime @default(now())

  @@unique([cardId, validFrom])
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  CARD_PAYMENT
}

enum PaymentMethod {
  PIX
  DEBIT
  CREDIT
  CASH
  BOLETO
  TED
}

/// The memory per merchant/person: the name you typed, plus (task 10) the names and CPF/CNPJ the
/// bank shows and the description and category to suggest.
model Counterparty {
  id                 String          @id @default(uuid(7))
  spaceId            String
  space              Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name               String
  /// normalizeName(name): one counterparty per name, regardless of case and accents.
  nameKey            String
  aliases            String[]        @default([])
  /// CPF or CNPJ, normalized: digits and (alphanumeric CNPJ) uppercase letters.
  document           String?
  defaultDescription String?
  defaultCategoryId  String?
  defaultCategory    Category?       @relation(fields: [defaultCategoryId], references: [id], onDelete: NoAction)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  transactions       Transaction[]
  recurringRules     RecurringRule[]

  @@unique([spaceId, nameKey])
  @@index([defaultCategoryId])
}

/// An expense, income, transfer or invoice payment. Which of account, card, destination and
/// invoice are set depends on the type and method (CHECK in the migration; see
/// docs/specs/tasks/08-transactions.md). The balance rule is src/domain/balance.ts.
model Transaction {
  id                 String          @id @default(uuid(7))
  spaceId            String
  space              Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// Given by the device, so a retried create (offline sync) doesn't duplicate.
  clientId           String
  createdById        String
  createdBy          User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  type               TransactionType
  /// Always positive; the type gives the direction.
  amountCents        Int
  /// The purchase (or competence) day, not an instant.
  date               DateTime        @db.Date
  method             PaymentMethod
  accountId          String?
  account            Account?        @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: NoAction)
  /// Transfer destination.
  toAccountId        String?
  toAccount          Account?        @relation("AccountTransfersIn", fields: [toAccountId], references: [id], onDelete: NoAction)
  cardId             String?
  card               Card?           @relation(fields: [cardId], references: [id], onDelete: NoAction)
  /// The invoice (by due date) a credit purchase falls on, or the one a payment pays.
  invoiceDueDate     DateTime?       @db.Date
  /// True when the invoice was chosen by hand: cycle changes don't recompute it.
  invoiceOverridden  Boolean         @default(false)
  categoryId         String?
  category           Category?       @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  counterpartyId     String?
  counterparty       Counterparty?   @relation(fields: [counterpartyId], references: [id], onDelete: NoAction)
  description        String?
  /// The installments of one credit purchase share this id (task 12); the three fields go
  /// together (CHECK in the migration).
  installmentGroupId String?
  /// 1…installmentTotal.
  installmentNumber  Int?
  /// 2–24.
  installmentTotal   Int?
  /// The subscription that charged this (task 13), and for which month ("YYYY-MM"): one charge
  /// per rule and month.
  recurringRuleId    String?
  recurringRule      RecurringRule?  @relation(fields: [recurringRuleId], references: [id], onDelete: NoAction)
  recurringMonth     String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([spaceId, clientId])
  @@unique([recurringRuleId, recurringMonth])
  @@index([installmentGroupId])
  @@index([spaceId, date])
  @@index([accountId])
  @@index([toAccountId])
  @@index([cardId, invoiceDueDate])
  @@index([categoryId])
  @@index([counterpartyId])
  @@index([createdById])
}

enum RuleStatus {
  ACTIVE
  PAUSED
  CANCELED
}

/// A subscription: a monthly expense the app charges by itself (task 13). Account, card and
/// method follow an expense's combinations (CHECK in the migration).
model RecurringRule {
  id             String                @id @default(uuid(7))
  spaceId        String
  space          Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User                  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  amountCents    Int
  /// 1–31; a day the month lacks means its last day.
  dayOfMonth     Int
  method         PaymentMethod
  accountId      String?
  account        Account?              @relation(fields: [accountId], references: [id], onDelete: NoAction)
  cardId         String?
  card           Card?                 @relation(fields: [cardId], references: [id], onDelete: NoAction)
  categoryId     String?
  category       Category?             @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  counterpartyId String?
  counterparty   Counterparty?         @relation(fields: [counterpartyId], references: [id], onDelete: NoAction)
  description    String?
  status         RuleStatus            @default(ACTIVE)
  canceledAt     DateTime?
  /// The month of the first charge ("YYYY-MM").
  firstMonth     String
  /// The first month the generation hasn't looked at yet (src/domain/recurring.ts).
  nextMonth      String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  transactions   Transaction[]
  changes        RecurringRuleChange[]

  @@index([spaceId, status, nextMonth])
  @@index([accountId])
  @@index([cardId])
  @@index([categoryId])
  @@index([counterpartyId])
  @@index([createdById])
}

/// A change in a subscription's amount, for the "assinatura mudou de valor" insight (task 24).
model RecurringRuleChange {
  id            String        @id @default(uuid(7))
  ruleId        String
  rule          RecurringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  previousCents Int
  amountCents   Int
  /// The day of the change, a calendar day.
  changedOn     DateTime      @db.Date
  createdAt     DateTime      @default(now())

  @@index([ruleId, createdAt])
}
